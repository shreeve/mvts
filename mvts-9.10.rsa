 S ^NEXT="8^V3TR08,V3TR09^V3TR,V3TEXT^VV3" D ^V3PRESET
 S a="" f i=1:1:51 s a=a_"ABCDE"
 s b="" f i=1:1:85 s b=b_"ABC"
 s c="" f i=1:1:51 s c=c_"abcde"
