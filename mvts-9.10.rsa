GVCOMP1 ;
 ;GET ^VCOMP(1,*) DATA
 S V="",N=""
 FOR  S N=$O(^VCOMP(1,N)) Q:N=""  S V=V_^VCOMP(1,N)
 S ^VCOMP=^VCOMP_V
 K ^VCOMP(1)
 Q
 ;
GVCOMP2 ;
 ;GET ^VCOMP(2,*) DATA
 S V="",N=""
 FOR  S N=$O(^VCOMP(2,N)) Q:N=""  S V=V_^VCOMP(2,N)
