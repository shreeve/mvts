 S ^VCOMP=$G(^VV,$P($g(^VV,^VV(1)),$g(^VV(8),"/"),$s($d(V):4,1:3),$L($g(^VV(1),"/"),"/")))
 S ^VCORR="C/D/E/F" D ^VEXAMINE
