 S ^VCOMP=^VCOMP_$D(A)_" "_$D(A("AB",2.4))_" "
 S ^VCOMP=^VCOMP_$D(B)_" "_$D(B("AB",2.4))_" "
 S ^VCOMP=^VCOMP_$D(C)_" "_$D(C("AB",2.4))_" "
 S ^VCOMP=^VCOMP_$D(D)_" "_$D(D("AB",2.4))_" "
