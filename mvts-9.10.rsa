 S XX(1)=1,XX(2)=2,XX(2,1,1)=211,XX(3)=3000 D DATA
 K XX(2,1,1) D DATA
 S ^VCORR="10 1 11 10 1 0 1 **1*2**211**3000*/10 1 1 0 0 0 1 **1*2****3000*/" D ^VEXAMINE
 ;
END W !!,"End of 111---V1DLB2",!
