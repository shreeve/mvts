 S V=""
 D %90
 S ^VCOMP=V,^VCORR="%90 " D ^VEXAMINE
 ;
2386 S ^ABSN="11631",^ITEM="I-238/239.6  label is a % followed by 7 digits",^NEXT="2387^V1DO1,V1DO2^V1DO,V1CALL^VV1" D ^V1PRESET
 S V=""
 D %0000000 S ^VCOMP=V,^VCORR="%0000000 " D ^VEXAMINE
 ;
