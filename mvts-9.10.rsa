3104 S ^ABSN="11377",^ITEM="I-310.4  -000.0110",^NEXT="311^V1FNL2,V1FNP1^V1FN,V1AC^VV1" D ^V1PRESET
 S ^VCOMP=$L(-000.0110),^VCORR=5 D ^VEXAMINE
