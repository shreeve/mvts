 S X="" F I=1:1 S Y=$O(A(X)) Q:Y=""  S VCOMP=VCOMP_($A(Y)-$A(X)) S X=Y
 S ^VCOMP=VCOMP,^VCORR="49111111111-25" F I=1:1:85 S ^VCORR=^VCORR_1
 D ^VEXAMINE
