 ;
1603 S ^ABSN="20179",^ITEM="II-160.3  lvn?5c",^NEXT="161^V2PAT2,V2PAT3^VV2" D ^V2PRESET
 S ^VCOMP="" F I=0:1:127 S A=$C(I,I,I,I,I),A=A?5c,^VCOMP=^VCOMP_A
