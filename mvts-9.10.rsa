 S ^VCOMP="",%=0 F %=98765432 S ^VCOMP=^VCOMP_%
 S ^VCOMP=^VCOMP_% S ^VCORR="9876543298765432" D ^VEXAMINE
 ;
336 W !,"I-336  expr is a numlit"
