V4SVQ1 ;IW-KO-YS-TS,V4SVQ,MVTS V9.10;15/6/96;PART-94
 ;COPYRIGHT MUMPS SYSTEMS LABORATORY 1994-1996
 ;
 W !!,"69---V4SVQ1:  Special variable $QUIT  -1-"
 ;
 W !!,"$QUIT=1",!
 ;
1 S ^ABSN="40515",^ITEM="IV-515  extrinsic special variable"
 S ^NEXT="2^V4SVQ1,V4SVQ2^V4SVQ,V4MERGE^VV4" D ^V4PRESET K
 S ^VCOMP=$$Q1ESV
 S ^VCORR="1" D ^VEXAMINE
 ;
2 S ^ABSN="40516",^ITEM="IV-516  extrinsic function"
 S ^NEXT="3^V4SVQ1,V4SVQ2^V4SVQ,V4MERGE^VV4" D ^V4PRESET K
 ;(test fixed in V9.02;7/10/95)
 S ^VCOMP=$$Q1ESF^V4SVQ1(1,2,3)_" "_V
 S ^VCORR="1 6" D ^VEXAMINE
 ;
3 W !!,"$QUIT=0",!
 ;
 S ^ABSN="40517",^ITEM="IV-517  DO"
 S ^NEXT="4^V4SVQ1,V4SVQ2^V4SVQ,V4MERGE^VV4" D ^V4PRESET K
 D Q0DO
 S ^VCOMP=V
 S ^VCORR="0" D ^VEXAMINE
 ;
4 S ^ABSN="40518",^ITEM="IV-518  argumentless DO"
 S ^NEXT="5^V4SVQ1,V4SVQ2^V4SVQ,V4MERGE^VV4" D ^V4PRESET K
 D
 . S V=$QUIT
 S ^VCOMP=V
 S ^VCORR="0" D ^VEXAMINE
 ;
5 S ^ABSN="40519",^ITEM="IV-519  DO with parameters"
 S ^NEXT="V4SVQ2^V4SVQ,V4MERGE^VV4" D ^V4PRESET K
 ;(test fixed in V9.02;7/10/95)
 D Q0DOWP(1,2)
 S ^VCOMP=V_" "_S
 S ^VCORR="0 3" D ^VEXAMINE
 ;
END W !!,"End of 69 --- V4SVQ1",!
 K  Q
 ;
SUM S SUM=0 F I=1:1 S L=$T(+I) Q:L=""  F K=1:1:$L(L) S SUM=SUM+$A(L,K)
 Q
Q1ESV() N V S V=$quit Q V
Q1ESF(X,Y,Z) ;
 S V=X+Y+Z Q $Q
Q0DO ;
 S V=$quit QUIT
Q0DOWP(X,Y) ;
 S S=X+Y
 S V=$quit QUIT

V4SVQ2
V4SVQ2 ;IW-KO-YS-TS,V4SVQ,MVTS V9.10;15/6/96;PART-94
 ;COPYRIGHT MUMPS SYSTEMS LABORATORY 1994-1996
