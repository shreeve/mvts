 ........... S ^VCOMP=^VCOMP_"K" D  S ^VCOMP=^VCOMP_"K"
 ............ S ^VCOMP=^VCOMP_"L" D  S ^VCOMP=^VCOMP_"L"
 ............. S ^VCOMP=^VCOMP_"M" D  S ^VCOMP=^VCOMP_"M"
