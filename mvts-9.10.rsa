 F I=1:1:100 Q:^VB=1  H 1
 S ^VA=2
 LOCK ^VF
 S ^VCOMP=^VA_" "_^VB
 S ^VCORR="20 1" D ^VEXAMINE K ^VA,^VB,^VF L
 ;
2 S ^ABSN="30364",^ITEM="III-364  LOCK -nref"
 S ^NEXT="3^V3LOCK1,V3LOCK2^V3LOCK,V3INDNM^VV3" D ^V3PRESET K
 S ^VA=1,^VB=0
 LOCK (^VA,^VB,^VC)
 JOB ^V3LOCKB
 F I=1:1:100 Q:^VB=1  H 1
 S ^VA=3
 LOCK -^VA
 S ^VB=5
 LOCK -^VB
 LOCK ^VF
 S ^VCOMP=^VA_" "_^VB
 S ^VCORR="30 150" D ^VEXAMINE K ^VA,^VB,^VC,^VF L
 ;
3 S ^ABSN="30365",^ITEM="III-365  LOCK +(nref)"
