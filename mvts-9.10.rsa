 S ^NEXT="V4SVQ6^V4SVQ,V4MERGE^VV4" D ^V4PRESET K
 ;(test fixed in V9.02;7/10/95)
 S ^VCOMP=$$ESVEOF^V4SVQE
 S ^VCORR="101" D ^VEXAMINE
 ;
END W !!,"End of 73 --- V4SVQ5",!
 K  Q
 ;
SUM S SUM=0 F I=1:1 S L=$T(+I) Q:L=""  F K=1:1:$L(L) S SUM=SUM+$A(L,K)
 Q
ESVDO() S V=$Q
 D ABC
 S V=V_$Q Q V
 ;
ABC S V=V_$Q Q
 ;
ESVFOR() ;
 N N S V=$q
 F N=3:1:5 S V=V_$quit Q:N=4
 S V=V_$q Q V
 ;
ESVGO() ;
 S V=$Q g ESVGO88^V4SVQE
 S V=66 Q V
 ;
ESVALDO() N V S V=$Q DO  S V=V_$Q Q V
 .S V=V_$Q

V4SVQ6
