 S ^NEXT="4^V4SVQ5,V4SVQ6^V4SVQ,V4MERGE^VV4" D ^V4PRESET K
 S ^VCOMP=$$ESVDW^V4SVQE
 S ^VCORR="101" D ^VEXAMINE
 ;
4 S ^ABSN="40536",^ITEM="IV-536  FOR scope"
 S ^NEXT="5^V4SVQ5,V4SVQ6^V4SVQ,V4MERGE^VV4" D ^V4PRESET K
 S ^VCOMP=$$ESVFOR
 S ^VCORR="1111" D ^VEXAMINE
 ;
5 S ^ABSN="40537",^ITEM="IV-537  GOTO"
 S ^NEXT="6^V4SVQ5,V4SVQ6^V4SVQ,V4MERGE^VV4" D ^V4PRESET K
 S ^VCOMP=$$ESVGO
 S ^VCORR="11" D ^VEXAMINE
 ;
