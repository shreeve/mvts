 S ^VCOMP="",I=0.0 F I=7.5 S ^VCOMP=^VCOMP_I
 S ^VCOMP=^VCOMP_I S ^VCORR="7.57.5" D ^VEXAMINE
 ;
337 W !,"I-337  expr is a strlit"
