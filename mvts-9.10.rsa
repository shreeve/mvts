 S ^VREPORT("Part-94",^ABSN,"NEXT")=^NEXT
 K ^VA,^VB,^VC,^VD,^VCOMP,^VS
 LOCK
 S ^VCOMP=""
 S ^VS(1)=1
 K
 S WAIT=""
 LOCK +^V(1)
 K ^HALT
TINIT ;------------------------------------------
 Q
 ;
