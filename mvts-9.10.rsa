 I $D(A("AB",2.4))#10=1 S ^VCOMP=^VCOMP_A("AB",2.4)
 I $D(B)#10=1           S ^VCOMP=^VCOMP_B
 I $D(B("AB",2.4))#10=1 S ^VCOMP=^VCOMP_B("AB",2.4)
