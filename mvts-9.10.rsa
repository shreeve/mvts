 S VCOMP=VCOMP_(""?.11"")_(X?21."")_(X?1.100"")_(X?5"")_" "
 S VCOMP=VCOMP_("@"?."")_("A"?.11"")_("B"?1."")_("C"?1.100"")_("D"?999"")
 S ^VCOMP=VCOMP,^VCORR="11111 1111 00000" D ^VEXAMINE
