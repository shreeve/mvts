 S ^NEXT="3^V3LOCK2,V3INDNM^VV3" D ^V3PRESET K
 S ^VA=1,^VB=0,^VE=""
 LOCK (^VA,^VB,^VC)
 JOB ^V3LOCKB
 F I=1:1:100 Q:^VB=1  H 1
 S ^VA=3
 LOCK -^VA:3 S ^VE=^VE_$T_"/"
 S ^VB=5
