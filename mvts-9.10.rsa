V3LOCK1 ;IW-KO-YS-TS,V3LOCK,MVTS V9.10;15/6/96;PART-90
 ;COPYRIGHT MUMPS SYSTEMS LABORATORY 1990-1996
 W !!,"35---V3LOCK1: +- LOCK command -1-",!
 ;
1 S ^ABSN="30363",^ITEM="III-363  LOCK +nref"
 S ^NEXT="2^V3LOCK1,V3LOCK2^V3LOCK,V3INDNM^VV3" D ^V3PRESET K
 S ^VA=1,^VB=0
 LOCK ^VA
