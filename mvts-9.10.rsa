 S ^NEXT="7^V3TR08,V3TR09^V3TR,V3TEXT^VV3" D ^V3PRESET
 s a="" f i=1:1:51 s a=a_"abcde"
 S ^VCOMP=$TR("ABCDEFGHIJ","ABC",a)
 S ^VCORR="abcDEFGHIJ" D ^VEXAMINE
